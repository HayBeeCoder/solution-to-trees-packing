 .../optimize/strategies/lattice.py            | 39 +++++++++++++++++++
 src/tree_packing/validation/gatekeeper.py     | 13 +++----
 tests/unit/test_strategy_registry.py          |  2 +-
 4 files changed, 52 insertions(+), 9 deletions(-)
 create mode 100644 src/tree_packing/optimize/strategies/lattice.py

